# =============================================================================
# .env.example — Copy to .env and customise for your machine
#   cp .env.example .env
# =============================================================================

# ── Host user IDs (run: id -u && id -g) ──────────────────────────────────────
HOST_UID=1000
HOST_GID=1000

# ── Directory paths on the HOST machine ──────────────────────────────────────
# Where the Yocto workspace lives on the host (created by init.sh on first run)
YOCTO_WORKSPACE=./workspace

# Shared caches — point at a NAS/NFS share to reuse across build machines
SSTATE_CACHE=./cache/sstate
DL_DIR=./cache/downloads

# ── Target board ─────────────────────────────────────────────────────────────
# mp157a-hdmi-lt-emmc-mx  → VisionSOM with HDMI bridge
# mp157a-dsi-rvt-emmc-mx  → VisionSOM with DSI display
MACHINE=mp157a-dsi-rvt-emmc-mx

# ── BitBake parallelism ─────────────────────────────────────────────────────
# Set to number of CPU cores.  Leave blank to auto-detect.
BB_NUMBER_THREADS=
PARALLEL_MAKE=

# ── Proxy (uncomment if behind a corporate proxy) ───────────────────────────
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
