# /etc/openvpn/client/<device-name>.conf
# Replace SERVER_IP, SERVER_PORT, and the cert/key filenames with the
# values issued for this specific device. Each device needs its own
# unique certificate/key pair from the VPN server administrator.

client
dev tun
proto udp
remote SERVER_IP SERVER_PORT
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-256-GCM
auth SHA256
ca ca.crt
cert <device>.crt
key <device>.key
tls-auth ta.key 1
verb 3
